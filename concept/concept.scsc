import scsc/base

[version] = 1
[type] = {
  
  @lang.php('int')
  @lang.ts('bigint')
  int64

  @lang.php('int')
  @lang.ts('number')
  int32

}

ns MappingType {
  const camelCase
  const snake_case
}

User {
  [version] = 2
  [map:local] = MappingType::camelCase

  // The users ID
  id: int

  @local(avatarImageId)
  avatar_image_id: int?

  avatar_image?: {
    data: Image?
  }

  // the last message the user sent
  last_messages: {
    cached: bool
    data: Message[]
  }
}

Image {
  colors: int[]
  proxy: {
    s1x1: string
  }
}

Message {
  unseen: bool
  text: string
  context: {
    @enum("text", "image")
    type: string
    data: Image|User
  } 
}
